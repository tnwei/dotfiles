{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 30, // Fixed height keeps the reserved screen area stable
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    
    // Choose the order of the modules
    "modules-left": [
        "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5",
        "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10",
        "custom/wsmagic",
        "niri/workspaces"
    ],
    "modules-center": [
        "hyprland/window",
        "niri/window"
    ],
    "modules-right": [
        "idle_inhibitor",
        // Do I really need CPU? I got thermals
        // "cpu",
        // "memory",
        "wireplumber", 
        "network", 
        "temperature", 
        // "backlight",
        // "keyboard-state", 
        "battery", "battery#bat2", 
        "clock", 
        "custom/exit",
        // What the hell is this tray thing? 
        // I was able to shrink OBS to it
        // What is this amazing thing???
        "tray"
    ],

    // Modules configuration
    // For icons, goto the Font Awesome website and copy the glyphs!
    // Fixed order, with live state from Hyprland. The ext/workspaces module
    // cannot keep numeric sorting when a named special workspace is included.
    "custom/ws1": {
        "exec": "hyprctl -j monitors | jq -c --arg n \"$WAYBAR_OUTPUT_NAME\" --argjson id 1 --argjson ws \"$(hyprctl -j workspaces)\" '.[] | select(.name==$n) as $m | if any($ws[]; .monitor==$n and .id==$id) then {text:(if ($m.activeWorkspace.id|tostring)==($id|tostring) then \"<span background=\\\"#26A65B\\\"> <b>1</b> </span>\" else \"1\" end)} else {text:\"\"} end' 2>/dev/null || echo '{\"text\":\"\"}'",
        "interval": 2,
        "return-type": "json",
        "format": "{text}",
        "escape": false,
        "min-length": 3,
        "align": 0.5,
        "hide-empty-text": true,
        "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 1 })\""
    },
